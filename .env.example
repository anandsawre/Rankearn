# ==============================================================================
# Rankearn Monorepo Environment Configuration Template
# ==============================================================================
# NOTE: Never commit production credentials, service_role keys, or secrets to Git.
# Copy this template to .env or pass variables via --dart-define during build.
# ==============================================================================

# --- Environment Mode ---
# Options: development | staging | production
APP_ENV=development

# --- Supabase Configuration (Client Safe: Anon Key Only) ---
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Publishable/Anon Key: Used in Flutter User App and Admin App with RLS
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# --- Server-Side Only Privileged Credentials (DO NOT BUNDLE IN FLUTTER APPS) ---
# Required strictly for migration scripts and Edge Functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# --- Google Gemini AI API Configuration (Server Only) ---
# Used strictly in Supabase Edge Functions or Cloudflare Worker for AI Question Generation
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# --- Firebase Service Account (Migration Tooling & FCM Push Only) ---
# Path to downloaded Firebase service account JSON key for data migration
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FCM Legacy Server Key or HTTP v1 Service Credentials (for push notifications)
FCM_SERVER_KEY=AAAAyour_fcm_server_key_here

# --- Cloudflare Worker / Edge Proxy ---
CLOUDFLARE_WORKER_URL=https://rankearn-worker.yourname.workers.dev

# --- Native App Scheme & Deep Links ---
APP_DEEP_LINK_SCHEME=rankearn
APP_URL=https://rankearn.in
